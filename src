class AssetManager:
    """Indexes and crops background images for the inner card container."""

    def __init__(self, backgrounds_dir: Path = BACKGROUNDS_DIR):
        self.backgrounds_dir = backgrounds_dir
        self.supported_extensions = {".png", ".jpg", ".jpeg", ".webp"}

    def get_available_backgrounds(self) -> list[str]:
        """Returns sorted list of background filenames inside assets/backgrounds/."""
        if not self.backgrounds_dir.exists():
            return []
        
        files = []
        for file in self.backgrounds_dir.iterdir():
            if file.is_file() and file.suffix.lower() in self.supported_extensions:
                files.append(file.name)
        return sorted(files)

    def load_background_image(self, bg_filename: str | None = None) -> Image.Image:
        """Loads and crops a background image to fit the inner card dimensions."""
        if bg_filename:
