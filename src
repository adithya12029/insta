            line_heights.append(h)
            total_height += h * 1.35

        start_y = PADDING + (CARD_HEIGHT / 2) - (total_height / 2) - 20

        for i, line in enumerate(lines):
            draw.text((left_margin, start_y), line, font=font, fill=COLOR_TEXT)
            start_y += line_heights[i] * 1.35

