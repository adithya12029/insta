    def __init__(self):
        self.fonts = self._load_fonts()

    def _apply_film_grain(self, image: Image.Image, intensity: int = GRAIN_INTENSITY) -> Image.Image:
        """Generates fine black stipple noise and overlays it on the canvas."""
        if intensity <= 0:
            return image

        w, h = image.size
        noise_bytes = os.urandom(w * h)
        noise_l = Image.frombytes("L", (w, h), noise_bytes)

        max_alpha = int(255 * (intensity / 100.0))
        alpha_channel = noise_l.point(lambda opacity: int((opacity / 255.0) * max_alpha))

        black_layer = Image.new("RGBA", (w, h), (0, 0, 0, 255))
        black_layer.putalpha(alpha_channel)

        return Image.alpha_composite(image.convert("RGBA"), black_layer)

    def _load_fonts(self) -> dict[str, ImageFont.ImageFont]:
        """Loads Georgia fonts with fallback support."""
        font_map = {}
        size_configs = {
            "cover": (FONT_BOLD_PATH, 68),
            "open": (FONT_REGULAR_PATH, 54),
            "mcq_q": (FONT_REGULAR_PATH, 48),
            "mcq_opt": (FONT_REGULAR_PATH, 44),
            "handle": (FONT_REGULAR_PATH, 28)
        }

        for key, (font_path, size) in size_configs.items():
            try:
                if font_path.exists():
                    font_map[key] = ImageFont.truetype(str(font_path), size)
                else:
                    font_map[key] = ImageFont.load_default()
            except Exception:
                font_map[key] = ImageFont.load_default()

        return font_map

    def wrap_text(self, text: str, font: ImageFont.ImageFont, max_width: int, draw: ImageDraw.ImageDraw = None) -> list[str]:
        """Word-wraps text to fit inside specified pixel width bounds."""
        clean_text = text.replace("_", "")

        if draw is None:
            dummy_img = Image.new("RGB", (1, 1))
            draw = ImageDraw.Draw(dummy_img)

        words = clean_text.split()
        lines = []
        current_line = []

        for word in words:
            test_line = ' '.join(current_line + [word])
            bbox = draw.textbbox((0, 0), test_line, font=font)
            width = bbox[2] - bbox[0]

            if width <= max_width:
                current_line.append(word)
            else:
                if current_line:
                    lines.append(' '.join(current_line))
                current_line = [word]

        if current_line:
            lines.append(' '.join(current_line))

        return lines

    def _build_card_base(self, bg_image: Image.Image | None = None) -> Image.Image:
        """Creates rounded card with an inner shadow vignette hugging the border curve."""
        if bg_image:
            img = bg_image.convert("RGBA")
            if img.size != (CARD_WIDTH, CARD_HEIGHT):
                img = ImageOps.fit(img, (CARD_WIDTH, CARD_HEIGHT), centering=(0.5, 0.5))
        else:
            img = Image.new("RGBA", (CARD_WIDTH, CARD_HEIGHT), COLOR_FALLBACK)

        # 1. Build Inner Shadow Alpha Mask
        shadow_mask = Image.new("L", (CARD_WIDTH, CARD_HEIGHT), 255)
        s_draw = ImageDraw.Draw(shadow_mask)

        inner_radius = max(1, CORNER_RADIUS - VIGNETTE_INSET)
        s_draw.rounded_rectangle(
            [VIGNETTE_INSET, VIGNETTE_INSET, CARD_WIDTH - VIGNETTE_INSET, CARD_HEIGHT - VIGNETTE_INSET],
            radius=inner_radius,
            fill=0
        )

        # 2. Softly blur mask inward across edge
        shadow_mask = shadow_mask.filter(ImageFilter.GaussianBlur(VIGNETTE_BLUR_RADIUS))

        black_vignette = Image.new("RGBA", (CARD_WIDTH, CARD_HEIGHT), (0, 0, 0, 255))
        black_vignette.putalpha(shadow_mask)

        card = Image.alpha_composite(img, black_vignette)

        # 3. Apply Rounded Corner Clipping Mask
        corner_mask = Image.new("L", (CARD_WIDTH, CARD_HEIGHT), 0)
        c_draw = ImageDraw.Draw(corner_mask)
        c_draw.rounded_rectangle([0, 0, CARD_WIDTH, CARD_HEIGHT], radius=CORNER_RADIUS, fill=255)

        card.putalpha(corner_mask)
        return card

    def _draw_brand_handle(self, draw: ImageDraw.ImageDraw):
        """Renders brand handle centered near bottom Y = 81% in pure white."""
        handle = BRAND_HANDLE if BRAND_HANDLE.startswith("@") else f"@{BRAND_HANDLE}"
        font = self.fonts["handle"]
        bbox = draw.textbbox((0, 0), handle, font=font)
        text_w = bbox[2] - bbox[0]

        x = (CANVAS_WIDTH - text_w) / 2
        y = CANVAS_HEIGHT * 0.81
        draw.text((x, y), handle, font=font, fill=COLOR_TEXT)

    def render_slide(self, slide_data: dict, bg_image: Image.Image | None = None) -> Image.Image:
        """Renders card background, text layer in white, and applies film grain."""
        canvas = Image.new("RGBA", (CANVAS_WIDTH, CANVAS_HEIGHT), COLOR_BG)
        card = self._build_card_base(bg_image)
        canvas.paste(card, (PADDING, PADDING), card)

        draw = ImageDraw.Draw(canvas)

        slide_type = slide_data.get("type", "cover")
        if slide_type == "cover":
            self._render_cover_slide(draw, slide_data)
        elif slide_type == "open":
            self._render_open_slide(draw, slide_data)
        elif slide_type in ("mcq", "mcq_question"):
            self._render_mcq_slide(draw, slide_data)

        self._draw_brand_handle(draw)
        canvas = self._apply_film_grain(canvas, intensity=GRAIN_INTENSITY)
        return canvas

    def _render_cover_slide(self, draw: ImageDraw.ImageDraw, data: dict):
        """Card Cover Layout: Centered bold text in pure white (no underlines)."""
        title_text = data.get("title", "")
        max_text_width = CARD_WIDTH - 160
        font = self.fonts["cover"]

        # Strip any underscores from the input string
        clean_text = title_text.replace("_", "")
        lines = self.wrap_text(clean_text, font, max_text_width, draw)

        # Calculate total height for vertical centering
        line_heights = []
        total_height = 0
        for line in lines:
            bbox = draw.textbbox((0, 0), line, font=font)
            h = bbox[3] - bbox[1]
            line_heights.append(h)
            total_height += h * 1.35

        start_y = PADDING + (CARD_HEIGHT / 2) - (total_height / 2) - 20

        # Render centered lines of text
        for i, line in enumerate(lines):
            bbox = draw.textbbox((0, 0), line, font=font)
            line_w = bbox[2] - bbox[0]
            line_x = PADDING + (CARD_WIDTH / 2) - (line_w / 2)

            draw.text((line_x, start_y), line, font=font, fill=COLOR_TEXT)

            start_y += line_heights[i] * 1.35

    def _render_open_slide(self, draw: ImageDraw.ImageDraw, data: dict):
        """Open Question Layout: Left-aligned question centered vertically in pure white."""
        question = data.get("question", data.get("title", ""))
        max_text_width = CARD_WIDTH - 200
        font = self.fonts["open"]
        left_margin = PADDING + 90

